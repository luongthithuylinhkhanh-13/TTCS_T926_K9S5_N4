# =============================================================================
# Nền tảng điều hành thi công công trình — Environment Variables
# =============================================================================
# Sao chép file này thành .env và điền giá trị thực tế:
#   cp .env.example .env
#
# CẢNH BÁO: .env không được commit vào Git.
# File này (.env.example) chỉ chứa placeholder, không chứa giá trị thực.
# =============================================================================

# --- Application ---
APP_ENV=development
APP_PORT=8080

# --- Database (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=construction_management
DB_USERNAME=postgres
DB_PASSWORD=

# --- JWT ---
# Dùng secret ngẫu nhiên dài tối thiểu 32 byte; bắt buộc thay khi deploy.
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-bytes

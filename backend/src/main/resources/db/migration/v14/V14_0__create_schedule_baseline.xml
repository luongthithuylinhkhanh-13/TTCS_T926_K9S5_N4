<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="V14.0-add-schedule-baseline-marker" author="NTDHTCT-41">
        <addColumn tableName="projects">
            <column name="schedule_baseline_captured_at" type="TIMESTAMP WITH TIME ZONE"/>
        </addColumn>
    </changeSet>

    <changeSet id="V14.1-create-schedule-baseline-items" author="NTDHTCT-41">
        <createTable tableName="project_schedule_baseline_items">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="project_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="item_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="wbs_code" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="start_date" type="DATE"/>
            <column name="end_date" type="DATE"/>
            <column name="duration" type="INT"/>
            <column name="captured_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
            baseTableName="project_schedule_baseline_items"
            baseColumnNames="project_id"
            referencedTableName="projects"
            referencedColumnNames="id"
            constraintName="fk_schedule_baseline_project"
            onDelete="CASCADE"/>

        <addUniqueConstraint
            tableName="project_schedule_baseline_items"
            columnNames="project_id,item_id"
            constraintName="uk_schedule_baseline_project_item"/>

        <createIndex tableName="project_schedule_baseline_items"
                     indexName="idx_schedule_baseline_project_code">
            <column name="project_id"/>
            <column name="wbs_code"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>

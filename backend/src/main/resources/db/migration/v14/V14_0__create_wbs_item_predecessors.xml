<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="V14.0-create-wbs-item-predecessors" author="NTDHTCT-26">
        <createTable tableName="wbs_item_predecessors">
            <column name="wbs_item_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="predecessor_id" type="UUID">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addPrimaryKey
            tableName="wbs_item_predecessors"
            columnNames="wbs_item_id, predecessor_id"
            constraintName="pk_wbs_item_predecessors"/>

        <addForeignKeyConstraint
            baseTableName="wbs_item_predecessors"
            baseColumnNames="wbs_item_id"
            referencedTableName="wbs_items"
            referencedColumnNames="id"
            constraintName="fk_wbs_item_predecessors_item"
            onDelete="CASCADE"/>

        <addForeignKeyConstraint
            baseTableName="wbs_item_predecessors"
            baseColumnNames="predecessor_id"
            referencedTableName="wbs_items"
            referencedColumnNames="id"
            constraintName="fk_wbs_item_predecessors_predecessor"
            onDelete="CASCADE"/>
    </changeSet>
</databaseChangeLog>

<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!--
        S-36 (NTDHTCT-220): Lập phiếu nghiệm thu theo đợt, tự tính
        Subtasks:
          - NTDHTCT-268 (T-83): Tạo phiếu nghiệm thu theo từng đợt
          - NTDHTCT-269 (T-84): Chọn hạng mục và nhập khối lượng nghiệm thu
          - NTDHTCT-270 (T-85): Tự động tính giá trị nghiệm thu của phiếu
    -->
    <changeSet id="V20.0-create-acceptance-reports" author="NTDHTCT-220">
        <createTable tableName="acceptance_reports">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="project_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="report_number" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="period_number" type="INTEGER" defaultValueNumeric="1">
                <constraints nullable="false"/>
            </column>
            <column name="acceptance_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(50)" defaultValue="DRAFT">
                <constraints nullable="false"/>
            </column>
            <column name="creator_id" type="UUID">
                <constraints nullable="true"/>
            </column>
            <column name="notes" type="TEXT"/>
            <column name="total_amount" type="DECIMAL(18,2)" defaultValueNumeric="0.00">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE"
                    defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE"
                    defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
            baseTableName="acceptance_reports"
            baseColumnNames="project_id"
            referencedTableName="projects"
            referencedColumnNames="id"
            constraintName="fk_acceptance_reports_project"
            onDelete="CASCADE"/>

        <createIndex tableName="acceptance_reports" indexName="idx_acceptance_reports_project">
            <column name="project_id"/>
        </createIndex>

        <rollback>
            <dropTable tableName="acceptance_reports" cascadeConstraints="true"/>
        </rollback>
    </changeSet>

    <changeSet id="V20.0-create-acceptance-items" author="NTDHTCT-220">
        <createTable tableName="acceptance_items">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="acceptance_report_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="wbs_item_id" type="UUID">
                <constraints nullable="true"/>
            </column>
            <column name="task_id" type="UUID">
                <constraints nullable="true"/>
            </column>
            <column name="item_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="unit" type="VARCHAR(50)"/>
            <column name="planned_quantity" type="DECIMAL(15,2)" defaultValueNumeric="0.00"/>
            <column name="accepted_quantity" type="DECIMAL(15,2)" defaultValueNumeric="0.00">
                <constraints nullable="false"/>
            </column>
            <column name="unit_price" type="DECIMAL(15,2)" defaultValueNumeric="0.00">
                <constraints nullable="false"/>
            </column>
            <column name="amount" type="DECIMAL(18,2)" defaultValueNumeric="0.00">
                <constraints nullable="false"/>
            </column>
            <column name="cumulative_quantity" type="DECIMAL(15,2)" defaultValueNumeric="0.00"/>
            <column name="notes" type="TEXT"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE"
                    defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
            baseTableName="acceptance_items"
            baseColumnNames="acceptance_report_id"
            referencedTableName="acceptance_reports"
            referencedColumnNames="id"
            constraintName="fk_acceptance_items_report"
            onDelete="CASCADE"/>

        <createIndex tableName="acceptance_items" indexName="idx_acceptance_items_report">
            <column name="acceptance_report_id"/>
        </createIndex>

        <rollback>
            <dropTable tableName="acceptance_items" cascadeConstraints="true"/>
        </rollback>
    </changeSet>

</databaseChangeLog>

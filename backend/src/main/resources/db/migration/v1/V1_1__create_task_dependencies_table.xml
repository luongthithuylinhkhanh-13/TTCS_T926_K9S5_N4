<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="S-06-create-task-dependencies-table" author="quynhkien">
        <createTable tableName="task_dependencies">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="task_dependencies_pkey" nullable="false"/>
            </column>
            <column name="predecessor_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_dependency_predecessor"
                             references="wbs_items(id)"
                             deleteCascade="true"/>
            </column>
            <column name="successor_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_dependency_successor"
                             references="wbs_items(id)"
                             deleteCascade="true"/>
            </column>
            <column name="dependency_type" type="VARCHAR(10)" defaultValue="FS">
                <constraints nullable="false"/>
            </column>
            <column name="lag_days" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="NOW()"/>
        </createTable>

        <addUniqueConstraint tableName="task_dependencies"
                             columnNames="predecessor_id, successor_id"
                             constraintName="uk_task_dependencies_pred_succ"/>

        <createIndex tableName="task_dependencies" indexName="idx_task_dependencies_predecessor">
            <column name="predecessor_id"/>
        </createIndex>
        <createIndex tableName="task_dependencies" indexName="idx_task_dependencies_successor">
            <column name="successor_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
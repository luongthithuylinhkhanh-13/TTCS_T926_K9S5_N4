<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="V1.2-create-tasks-table" author="ai-assistant">
        <createTable tableName="tasks">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="duration" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="early_start" type="INT" defaultValueNumeric="0"/>
            <column name="early_finish" type="INT" defaultValueNumeric="0"/>
            <column name="late_start" type="INT" defaultValueNumeric="0"/>
            <column name="late_finish" type="INT" defaultValueNumeric="0"/>
            <column name="total_float" type="INT" defaultValueNumeric="0"/>
            <column name="is_critical" type="BOOLEAN" defaultValueBoolean="false"/>
        </createTable>

        <createTable tableName="task_dependencies">
            <column name="task_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="predecessor_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addPrimaryKey tableName="task_dependencies" columnNames="task_id, predecessor_id" constraintName="pk_task_dependencies"/>

        <addForeignKeyConstraint baseTableName="task_dependencies" baseColumnNames="task_id"
                                 referencedTableName="tasks" referencedColumnNames="id"
                                 constraintName="fk_task_dependencies_task_id"/>

        <addForeignKeyConstraint baseTableName="task_dependencies" baseColumnNames="predecessor_id"
                                 referencedTableName="tasks" referencedColumnNames="id"
                                 constraintName="fk_task_dependencies_predecessor_id"/>
    </changeSet>

</databaseChangeLog>

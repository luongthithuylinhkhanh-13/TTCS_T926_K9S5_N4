<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!--
        V3.0 - Add login security fields
        Dùng cho chức năng:
        - Đếm số lần đăng nhập sai
        - Khóa tài khoản sau 5 lần sai
        - Lưu thời gian hết khóa
    -->

    <changeSet id="V3.0-add-login-security-fields" author="T-03.3">

        <comment>
            Bổ sung các trường phục vụ xác thực người dùng:
            failed_login_attempts và locked_until.
        </comment>

        <addColumn tableName="users">

            <column name="failed_login_attempts"
                    type="INT"
                    defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>

            <column name="locked_until"
                    type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="true"/>
            </column>

        </addColumn>

        <rollback>
            <dropColumn
                    tableName="users"
                    columnName="locked_until"/>

            <dropColumn
                    tableName="users"
                    columnName="failed_login_attempts"/>
        </rollback>

    </changeSet>

</databaseChangeLog>